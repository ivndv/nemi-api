{
	"name": "nemi-api",
	"version": "1.0.0",
	"scripts": {
		"start": "TZ=UTC node dist/server.js",
		"dev": "TZ=UTC tsx watch server.ts",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun db/migrate.ts",
		"db:seed": "bun db/seed.ts",
		"db:reset": "bun db/reset.ts",
		"db:verify": "bun db/verify.ts",
		"db:studio": "drizzle-kit studio",
		"db:check": "drizzle-kit check",
		"openapi:check": "bun openapi/check.ts",
		"db:admin": "bun db/crear-admin.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"description": "API de gestión de activos Nemi",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1161.0",
		"compression": "^1.8.2",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.4",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.2",
		"helmet": "^8.3.0",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.5.0",
		"mysql2": "^3.24.6",
		"rate-limit-redis": "^6.0.2",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.6.7",
		"zod-openapi": "^6.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.3.0",
		"@types/node": "^26.6.6",
		"@types/swagger-ui-express": "^4.1.8",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
