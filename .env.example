# Configuración del Entorno de Node.js
NODE_ENV=development

# Configuración del Servidor
SERVER_PORT=3030
FRONTEND_URL=http://localhost:4200
# Opcional: lista separada por comas; si existe, reemplaza a FRONTEND_URL
CORS_ORIGINS=http://localhost:4200,https://nemi.mgdc.site

# Documentación Swagger/OpenAPI pública en /api/docs
# Logs: debug | info | warn | error (valor inválido cae a info)
LOG_LEVEL=info

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nemi-db

# Seguridad (JSON Web Tokens)
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Microservicio Externo
HASH_SERVICE_URL=http://localhost:3010
HASH_SERVICE_KEY=

# Cloudflare R2 - Almacenamiento de imagenes
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=assets-mgdc
R2_PUBLIC_URL=https://assets.liuma.app/nemi

# Contraseña de los usuarios creados por db:seed (solo desarrollo)
SEED_PASSWORD=Nemi123!

# Bootstrap del primer administrador (bun run db:admin)
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=CambiaEstaPassword123
ADMIN_NOMBRE=Administrador

# Redis (opcional: si no existe, se usa memoria)
REDIS_URL=redis://:password@localhost:6379
